# OPENROUTER_API_KEY: Used for chat (routed to google/gemini-2.5-pro via OpenRouter).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FAL_KEY: Clave de API de fal.ai para generación de imágenes (modelo nano-banana-2).
# Obtén una en https://fal.ai/dashboard/keys
FAL_KEY=

# WorkOS AuthKit — obtén estos valores en https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generar con: openssl rand -base64 32  (mínimo 32 caracteres)
WORKOS_COOKIE_PASSWORD=
# URL de callback OAuth — debe coincidir con la configurada en WorkOS
WORKOS_REDIRECT_URI="http://localhost:3000/callback"


DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# APP_DATABASE_URL: connection string for the app_user role (no BYPASSRLS).
# All application runtime code reads this; DATABASE_URL is reserved for
# migrations / admin tooling. See claude/skills/database/SKILL.md.
APP_DATABASE_URL="postgresql://app_user:password@localhost:5432/postgres"

# PILOT_TENANT_ID: uuid of the institutional tenant served by this deployment.
# Used by src/auth/resolve-identity.ts to bridge a WorkOS-authenticated user
# to a (tenant_id, user_id) row before any repos(...) call. Pilot scope only;
# multi-tenant lookup will replace this with a tenants repo + workos_org_id.
PILOT_TENANT_ID=

# LOG_LEVEL: pino level (trace|debug|info|warn|error|fatal). Default: info.
LOG_LEVEL=info

# REDIS_URL: Redis connection string used as the orchestrator's wake-up
# channel (Pub/Sub) for PlannerDecision and ArtifactPublishedEvent
# notifications. See claude/skills/mypes-architecture/SKILL.md §2.5, §2.10.
# When unset, the app falls back to in-process EventEmitter notifiers
# (single-process dev/test only).
REDIS_URL=