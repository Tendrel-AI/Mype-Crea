# LLM_PROVIDER: openrouter (default) or anthropic. Selects the provider for evals and direct
# provider calls (change it and restart), and the primary profile when a platform admin
# captures an AI release baseline draft. Chat turns use the provider pinned in their AI
# release, not this value; see docs/operations.md. Only the selected provider key is required.
LLM_PROVIDER=openrouter

# OPENROUTER_API_KEY: Used when LLM_PROVIDER=openrouter (extractor: google/gemini-2.5-flash;
# responder: google/gemini-2.5-pro).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional OpenRouter model IDs (provider/model slug format).
OPENROUTER_EXTRACTOR_MODEL=google/gemini-2.5-flash
OPENROUTER_RESPONDER_MODEL=google/gemini-2.5-pro

# ANTHROPIC_API_KEY: Used when LLM_PROVIDER=anthropic (direct Messages API;
# extractor: claude-haiku-5-5, responder: claude-sonnet-5-5).
ANTHROPIC_API_KEY=
# Optional direct Claude model IDs (claude-* format; OpenRouter slugs are rejected).
# Overrides must support their task's request features: the extractor and the eval
# judge need forced tool calls, which Claude Sonnet 5.5 rejects.
ANTHROPIC_EXTRACTOR_MODEL=claude-haiku-5-5
ANTHROPIC_RESPONDER_MODEL=claude-sonnet-5-5

# FAL_KEY: fal.ai key for image generation (nano-banana-2). Independent of
# LLM_PROVIDER: images always use fal.ai. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# WorkOS AuthKit. Values come from https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32  (at least 32 characters)
WORKOS_COOKIE_PASSWORD=
# OAuth callback URL; must match the redirect configured in WorkOS.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"


# Local development defaults for compose.yaml. These credentials are only for
# loopback-bound development services. Never reuse them outside your machine.
DATABASE_URL="postgresql://postgres:local_dev_only@127.0.0.1:5434/creamype"

# APP_DATABASE_URL: connection string for the app_user role (no BYPASSRLS).
# All application runtime code reads this; DATABASE_URL is reserved for
# migrations / admin tooling. See docs/agents/database.md.
# The app_user bootstrap password comes from the initial migration and must be
# rotated before connecting to any non-local database.
APP_DATABASE_URL="postgresql://app_user:change_me_immediately@127.0.0.1:5434/creamype"

# WorkOS user ID eligible for the one-time persisted first-superadmin bootstrap.
# After that grant, platform access is controlled by the persisted role; revocation
# does not grant this account access again. Leave blank after bootstrap if desired.
PLATFORM_BOOTSTRAP_SUPERADMIN_WORKOS_USER_ID=

# LOG_LEVEL: pino level (trace|debug|info|warn|error|fatal). Default: info.
LOG_LEVEL=info

# REDIS_URL: Redis connection string used as the orchestrator's wake-up
# channel (Pub/Sub) for PlannerDecision and ArtifactPublishedEvent
# notifications. See docs/agents/architecture.md §2.5, §2.10.
# When unset, the app falls back to in-process notifiers and LocalAdapter.
# Redis is required for the logo worker to persist deliverables for display.
# The worker boots automatically inside the Next.js process when Redis is set.
REDIS_URL="redis://127.0.0.1:6379"

# KAN-70 AI release runtime identity. Source deployments can compute these
# fingerprints from the complete source set; source-less deployments must set
# both fingerprints at build time. Runtime version defaults to package.json.
AI_CONFIG_RUNTIME_VERSION=
AI_CONFIG_CODE_FINGERPRINT=
AI_CONFIG_DEPENDENCY_FINGERPRINT=
# Tenant availability switches: true/false only; default is enabled.
AI_CONFIG_OPENROUTER_ENABLED=true
AI_CONFIG_ANTHROPIC_ENABLED=true

# LangSmith: LLM evals (`npm run eval`) and dev-only tracing. Never enable tracing in
# production (prompts carry tenant business data); the code ignores it when NODE_ENV=production.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=mypes-dev
# Optional: evaluation judge model override; defaults are selected by LLM_PROVIDER.
# OpenRouter example: EVAL_JUDGE_MODEL=anthropic/claude-sonnet-5
# Anthropic example (judge uses forced tools): EVAL_JUDGE_MODEL=claude-haiku-5-5
# Optional, evals only: EVAL_MODEL_PROFILE=cheap|free swaps the extractor, responder and
# judge models of the selected provider for low-cost ones during `npm run eval*`
# (cheap: google/gemini-2.5-flash-lite on OpenRouter; free: google/gemma-4-31b-it:free
# on OpenRouter, rate-limited; both: claude-haiku-5-5 on Anthropic). It overrides the
# model variables above for the eval process only; unset keeps the normal models.
# Evals still cost tokens (except free OpenRouter models) and need owner approval.
# EVAL_MODEL_PROFILE=cheap
