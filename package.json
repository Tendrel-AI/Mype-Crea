{
  "name": "mype-crea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "services:up": "docker compose up -d postgres redis",
    "services:down": "docker compose stop postgres redis",
    "services:status": "docker compose ps postgres redis",
    "dev": "next dev",
    "build": "next build && (cp -r public .next/standalone/ || true) && cp -r .next/static .next/standalone/.next/",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "clean": "next clean",
    "migrate:create": "dotenv -e .env.local -- node-pg-migrate create",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate down",
    "migrate:redo": "dotenv -e .env.local -- node-pg-migrate redo",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.local -- vitest run",
    "eval": "dotenv -e .env.local -- vitest run -c vitest.eval.config.ts",
    "eval:extractor": "dotenv -e .env.local -- vitest run -c vitest.eval.config.ts evals/extractor.eval.ts",
    "eval:responder": "dotenv -e .env.local -- vitest run -c vitest.eval.config.ts evals/responder.eval.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@hookform/resolvers": "^5.2.1",
    "@workos-inc/authkit-nextjs": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.1",
    "langsmith": "^0.10.8",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.2.3",
    "node-pg-migrate": "^8.0.4",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
