{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of CreaMype",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address"
        },
        "name": {
          "type": "string",
          "description": "The user's display name"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "The user's role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was created"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "A brand creation session for a user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier of the user who owns this session"
        },
        "step": {
          "type": "number",
          "description": "The current step in the brand creation process (1-6)"
        },
        "assets": {
          "type": "object",
          "description": "The brand assets generated so far",
          "properties": {
            "name": { "type": "string" },
            "profile": { "type": "string" },
            "logoUrl": { "type": "string" },
            "labelUrl": { "type": "string" },
            "landingPage": { "type": "string" },
            "marketingPlan": { "type": "string" }
          }
        },
        "messages": {
          "type": "array",
          "description": "The chat messages displayed to the user",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string", "enum": ["user", "model"] },
              "text": { "type": "string" },
              "isImage": { "type": "boolean" },
              "imageUrl": { "type": "string" },
              "isSystem": { "type": "boolean" }
            }
          }
        },
        "chatHistory": {
          "type": "array",
          "description": "The raw chat history sent to the Gemini API",
          "items": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the session was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the session was last updated"
        }
      },
      "required": ["uid", "step", "assets", "messages", "chatHistory", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Stores brand creation sessions for a specific user"
    }
  }
}
